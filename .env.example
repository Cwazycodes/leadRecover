APP_NAME=LeadRecover
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
#   Local quick-start uses SQLite. For Docker/production use MySQL:
#   DB_CONNECTION=mysql  DB_HOST=mysql  DB_PORT=3306
#   DB_DATABASE=leadrecover  DB_USERNAME=leadrecover  DB_PASSWORD=secret
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=leadrecover
# DB_USERNAME=root
# DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions / cache / queue
#   Production: SESSION_DRIVER=redis, CACHE_STORE=redis, QUEUE_CONNECTION=redis
#   (and run `php artisan queue:work`). "sync" runs jobs inline — dev only.
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail (use a real transport such as Postmark/SES/Mailgun in production)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@leadrecover.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# LeadRecover
# ---------------------------------------------------------------------------
LEADRECOVER_TRIAL_DAYS=14
# Shorten these (minutes) in dev to watch the follow-up flow quickly.
# LEADRECOVER_FOLLOWUP_1=60
# LEADRECOVER_FOLLOWUP_2=1440
# LEADRECOVER_FOLLOWUP_STALE=4320

# ---------------------------------------------------------------------------
# Twilio  (Voice + SMS + WhatsApp)
#   Set TWILIO_ENABLED=true with real credentials to actually send messages.
#   Each business connects its own number via Settings → Business profile.
# ---------------------------------------------------------------------------
TWILIO_ENABLED=false
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---------------------------------------------------------------------------
# Stripe / Cashier
#   Create three recurring Prices in Stripe and paste their IDs below.
#   Webhook endpoint: POST {APP_URL}/stripe/webhook
# ---------------------------------------------------------------------------
CASHIER_CURRENCY=gbp
CASHIER_CURRENCY_LOCALE=en_GB
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
